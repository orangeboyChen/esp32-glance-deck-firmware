{
  "name": "ESP32 Glance Deck Firmware",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "esp",
  "workspaceFolder": "/workspaces/esp32-glance-deck-firmware",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "espressif.esp-idf-extension"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "/home/esp/.bun/bin:/home/esp/.cargo/bin:${containerEnv:PATH}",
    "MCU": "esp32s3",
    "RUSTUP_TOOLCHAIN": "esp",
    "ESP_IDF_VERSION": "v5.3.1",
    "ESP_IDF_COMPONENT_MANAGER": "false"
  }
}
